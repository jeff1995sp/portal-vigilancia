{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "imagens/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/pix",
      "dest": "/api/pix.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}